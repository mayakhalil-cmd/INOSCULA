// Hand painted: painted light, cool shadows, matte paint
name "Hand Painted";

uniform vec3 localColor = vec3(0.55, 0.24, 0.13);   // @color @label Object Color
uniform vec3 lightTint = vec3(1.0, 0.86, 0.62);     // @color @label Light Color
uniform vec3 shadowTint = vec3(0.28, 0.22, 0.62);   // @color @label Shadow Color
uniform vec3 edgeTint = vec3(1.0, 0.32, 0.18);      // @color @label Light-To-Shadow Band
uniform vec3 bounceTint = vec3(0.95, 0.55, 0.35);   // @color @label Bounce Light
uniform vec3 rimTint = vec3(0.55, 0.75, 1.0);       // @color @label Rim Light
uniform vec3 highlightPaint = vec3(1.0, 0.95, 0.82); // @color @label Highlight
uniform float strokeSize = 2.0;                      // @range 0.5 12 @label Stroke Density
uniform float strokeLength = 2.6;                    // @range 1 8 @label Stroke Length
uniform float combing = 1.2;                         // @range 0 4 @label Dragged Edges
uniform float brushiness = 0.22;                     // @range 0 0.6 @label Brush Breakup
uniform float softness = 0.07;                       // @range 0.01 0.4 @label Value Softness
uniform float valueSteps = 5.0;                      // @range 2 10 @label Paint Values
uniform float stepped = 0.85;                        // @range 0 1 @label Stroke Values
uniform float hueJitter = 0.18;                      // @range 0 0.5 @label Stroke Color Jitter
uniform float shadowEdge = 0.62;                     // @range 0 1 @label Shadow Edge
uniform float bandWidth = 0.08;                      // @range 0 0.3 @label Band Width
uniform float bounce = 0.3;                          // @range 0 1 @label Bounce Amount
uniform float rim = 0.15;                            // @range 0 1 @label Rim Amount
uniform float reflections = 0.25;                     // @range 0 1 @label Reflections (paint barely reflects)
uniform float highlightSize = 0.015;                  // @range 0 0.4 @label Highlight Size
uniform float crevices = 0.6;                        // @range 0 1 @label Crevice Accents (needs Prepare model)
uniform float edgeWear = 0.35;                       // @range 0 1 @label Edge Highlights (needs Prepare model)
uniform float grain = 0.4;                           // @range 0 1 @label Paper Grain
uniform float adapt = 1.0;                           // @range 0 1 @label Adapt To Object
uniform float followView = 0.6;                      // @range 0 1 @label Strokes Follow The View
uniform float drift = 0.0;                           // @range 0 1 @label Drift
uniform float fps = 6.0;                             // @range 0 24 @label Repaint FPS
uniform float repaint = 0.0;                         // @range 0 1 @label Repaint Amount

vec3 crossv(vec3 a, vec3 b) {
  return vec3(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x);
}

// One coat of dabs
vec3 dabCoat(vec3 p, vec3 n, vec3 axis, float size, float len, vec3 seed) {
  vec3 pp = p + seed;
  float pd = voronoi(pp, size * 0.3, 1.0);
  vec3 pc = pd.position;
  vec3 pr = pd.color;
  vec3 t = normalize(crossv(n, axis) + crossv(n, vec3(0.31, 0.47, 0.83)) * 0.3 + vec3(0.0001, 0.0002, 0.0003));
  t = normalize(t + crossv(n, t) * (pr.x - 0.5) * 0.45);
  vec3 o = pp - pc;
  float along = dot(o, t);
  // Rounder dabs facing the camera
  float lenHere = mix(len, 1.0, pow(saturate(dot(n, axis)), 6.0));
  vec3 o2 = (o - t * along) * lenHere + t * along;
  // Dragged dab ends
  float comb = noise((o - t * along) * size * lenHere * 2.5 + pr * 5.0, 1.0, 2.0, 0.5, 2.0);
  o2 = o2 + t * (comb - 0.5) * (combing / size);
  float d = voronoi(o2 + pr * 37.0, size, 1.0);
  vec3 r = d.color;
  float streak = noise((o - t * along) * size * lenHere * 5.0 + t * along * size * 0.7 + pr * 11.0, 1.0, 2.0, 0.5, 2.0);
  float h = r.y * 0.25 + (1.0 - d) * 0.15 + streak * 0.08;
  return vec3(r.x, h, streak);
}

// Brush position
vec3 adaptPos(vec3 op, vec3 on) {
  return op * mix(1.0, 2.6 / max(object_size, 0.001), adapt);
}

// Two coats
vec3 paint2(vec3 p, vec3 n, vec3 axis, float size, float len, vec3 seed) {
  vec3 a = dabCoat(p, n, axis, size, len, seed);
  vec3 b = dabCoat(p, n, axis, size * 1.4, len, seed + vec3(5.1, 2.3, 7.7));
  float top = step(0.5, hash(vec3(floor(b.x * 997.0), 1.0, 1.0)));
  return vec3(mix(a.x, b.x, top), mix(a.y, 1.0 + b.y, top), mix(a.z, b.z, top));
}

void main() {
  float frame = floor(time * fps);
  vec3 seed = vec3(hash(vec3(frame, 1.0, 5.0)), hash(vec3(frame, 2.0, 5.0)), hash(vec3(frame, 3.0, 5.0))) * repaint * 3.0 + vec3(time * drift * 0.1, 0.0, time * drift * 0.05);
  vec3 n = normal;
  vec3 V = view_dir;
  vec3 axis = normalize(mix(vec3(0.0, 0.0, 1.0), V, followView));
  vec3 pt = paint2(adaptPos(object_pos, object_normal), n, axis, strokeSize, strokeLength, seed);
  float rnd = pt.x;
  float streak = pt.z;

  // Painted light
  float l = dot(n, light_dir) * 0.5 + 0.5 + (rnd - 0.5) * brushiness + (streak - 0.5) * brushiness * 0.5;
  // Values are mixed on the palette
  l = mix(l, (floor(l * valueSteps + rnd * 0.8) + 0.5) / valueSteps, stepped);
  float occ = mix(1.0, occlusion, crevices);
  float lit = smoothstep(shadowEdge - softness, shadowEdge + softness, l * mix(1.0, occ, 0.5));
  vec3 shadowCol = mix(localColor * shadowTint * 1.4, shadowTint * 0.35, 0.35);
  vec3 litCol = localColor * lightTint * (0.88 + 0.22 * step(0.86, l));
  vec3 c = mix(shadowCol, litCol, lit);

  // Light to shadow band
  float band = smoothstep(shadowEdge - softness - bandWidth, shadowEdge - softness * 0.3, l) * (1.0 - smoothstep(shadowEdge + softness * 0.3, shadowEdge + softness + bandWidth, l));
  c = mix(c, edgeTint * mix(localColor, vec3(1.0, 1.0, 1.0), 0.4), band * 0.55);

  // Bounce light
  float up = saturate(0.0 - n.z) * (1.0 - lit);
  c = mix(c, c + bounceTint * localColor * 0.6, up * bounce);
  float edge = pow(1.0 - saturate(dot(n, V)), 3.0);
  c = mix(c, rimTint * mix(localColor, vec3(1.0, 1.0, 1.0), 0.5), edge * rim * (1.0 - lit) * step(0.35, rnd) * reflections * 2.0);

  // Highlight dabs
  vec3 h = normalize(light_dir + V);
  float spot = smoothstep(1.0 - highlightSize, 1.0 - highlightSize * 0.5, dot(n, h) + (rnd - 0.5) * 0.03 + (streak - 0.5) * 0.03);
  c = mix(c, highlightPaint, spot * 0.6 * step(0.3, streak) * reflections);

  // Painted accents
  c = c * mix(1.0, 0.45 + 0.55 * occlusion, crevices);
  c = mix(c, mix(c, lightTint, 0.5), smoothstep(0.62, 0.85, curvature) * edgeWear * lit);

  // Brush texture and paper grain
  c = c * (vec3(1.0, 1.0, 1.0) + (vec3(rnd, fract(rnd * 7.3), fract(rnd * 13.7)) - vec3(0.5, 0.5, 0.5)) * hueJitter);
  c = c * (0.86 + 0.28 * streak);
  float g = white_noise(floor(world_pos * 400.0));
  c = c * (1.0 - grain * 0.06 + grain * 0.12 * g);
  color = c;
}

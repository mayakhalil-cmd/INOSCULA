// Painted character: shadow, midtone and highlight brushes
name "Painted Character";

uniform vec3 baseColor = vec3(0.72, 0.42, 0.36);    // @color @label Base Colour
uniform vec3 shadowTint = vec3(0.32, 0.2, 0.5);       // @color @label Shadow Tint
uniform vec3 highlightTint = vec3(1.0, 0.86, 0.7);  // @color @label Highlight Tint
uniform float shadowEdge = 0.55;                     // @range 0 1 @label Shadow Edge
uniform float highlightEdge = 0.88;                  // @range 0 1 @label Highlight Edge
uniform float softness = 0.04;                       // @range 0 0.3 @label Mask Softness
uniform float shadowBrush = 6.0;                     // @range 1 20 @label Shadow Brush Size
uniform float midBrush = 10.0;                       // @range 1 20 @label Midtone Brush Size
uniform float highlightBrush = 14.0;                 // @range 1 30 @label Highlight Brush Size
uniform float brushEdge = 0.32;                      // @range 0 0.5 @label Brush Edge Breakup
uniform float lineWidth = 0.007;                     // @range 0 0.05 @label Outline Width
uniform vec3 lineColor = vec3(0.12, 0.06, 0.1);     // @color @label Outline Colour

float brush(vec3 p, vec3 dir, float size) {
  float a = dot(p, dir);
  vec3 across = p - dir * a;
  return noise(across * size * 3.0 + dir * a * size * 0.5, 1.0, 3.0, 0.55, 2.0);
}

void main() {
  vec3 p = object_pos;
  float bs = brush(p, normalize(vec3(1.0, 0.2, 0.5)), shadowBrush);
  float bm = brush(p + vec3(3.0, 1.0, 0.0), normalize(vec3(0.2, 1.0, 0.3)), midBrush);
  float bh = brush(p + vec3(7.0, 0.0, 2.0), normalize(vec3(0.6, -0.4, 1.0)), highlightBrush);

  // Light
  float l = dot(normal, light_dir) * 0.5 + 0.5;
  float lit = smoothstep(shadowEdge - softness, shadowEdge + softness, l + (bs - 0.5) * brushEdge);
  float high = smoothstep(highlightEdge - softness, highlightEdge + softness, l + (bh - 0.5) * brushEdge);

  vec3 shadowCol = baseColor * shadowTint * (0.8 + 0.4 * bs);
  vec3 midCol = baseColor * (0.88 + 0.24 * bm);
  vec3 highCol = mix(baseColor, highlightTint, 0.55) * (0.92 + 0.16 * bh);
  vec3 c = mix(shadowCol, midCol, lit);
  c = mix(c, highCol, high);
  color = c;
  outline = lineWidth;
  outline_color = lineColor;
  outline_breakup = 0.35;
}

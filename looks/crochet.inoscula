// Crochet: rows of round stitches
name "Crochet";

uniform vec3 yarn = vec3(0.30, 0.55, 0.78);   // @color @label Yarn
uniform vec3 gap = vec3(0.04, 0.05, 0.08);    // @color @label Holes
uniform float cols = 40.0;                     // @range 8 120 @label Stitches Across
uniform float rows = 26.0;                     // @range 8 120 @label Rows
uniform float hole = 0.16;                     // @range 0 0.3 @label Hole Size

void main() {
  float v = uv.y * rows;
  float row = floor(v);
  float u = uv.x * cols + mod(row, 2.0) * 0.5;
  float dx = fract(u) - 0.5;
  float dy = (fract(v) - 0.5) * 1.15;
  float r = sqrt(dx * dx + dy * dy);

  float ring = 1.0 - smoothstep(0.1, 0.24, abs(r - 0.3));
  float a = atan(dy, dx);
  float twist = 0.5 + 0.5 * sin(a * 7.0 + r * 30.0);
  float strand = ring * (0.75 + 0.25 * twist);
  float isHole = 1.0 - smoothstep(hole, hole + 0.05, r);

  float ndl = dot(normal, light_dir);
  float light = smoothstep(-0.5, 1.0, ndl);
  float hair = noise(object_pos, 80.0, 1.0, 0.5, 2.0);
  vec3 c = yarn * (0.3 + 0.8 * strand) * (0.45 + 0.65 * light) * (0.9 + 0.2 * hair);
  color = mix(c, gap, isHole);
}

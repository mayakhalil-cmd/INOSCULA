// Claymation: plasticine, thumbprints, waxy shine
name "Claymation";

uniform vec3 clay = vec3(0.78, 0.33, 0.18);   // @color @label Clay
uniform vec3 shadow = vec3(0.25, 0.07, 0.10); // @color @label Shadow
uniform float prints = 0.6;                    // @range 0 1 @label Thumbprints
uniform float lumps = 0.35;                    // @range 0 1 @label Mixing Streaks
uniform float wax = 0.35;                      // @range 0 1 @label Wax Shine
uniform float fps = 12.0;                      // @range 1 24 @label Frames Per Second
uniform float boil = 0.04;                     // @range 0 0.2 @label Handling

void main() {
  float frame = floor(time * fps);
  vec3 nudge = vec3(hash(vec3(frame, 4.0, 1.0)), hash(vec3(frame, 5.0, 1.0)), hash(vec3(frame, 6.0, 1.0))) * boil;
  vec3 p = object_pos + nudge;

  // Soft blend
  float ndl = dot(normal, light_dir);
  float wrap = smoothstep(-0.45, 1.0, ndl);

  // Kneading marks
  float streak = noise(p * vec3(1.0, 1.0, 3.0), 2.2, 3.0, 0.55, 2.0);
  vec3 tint = clay * (1.0 + (streak - 0.5) * lumps);

  // Thumbprints
  float patch = smoothstep(0.48, 0.62, noise(p, 1.4, 1.0, 0.5, 2.0));
  float swirl = noise(p, 3.0, 2.0, 0.5, 2.0);
  float ridges = 0.5 + 0.5 * sin(length(fract(p * 1.3) - vec3(0.5)) * 90.0 + swirl * 12.0);
  float press = ridges * patch * prints;

  vec3 c = mix(shadow, tint, wrap) * (1.0 - press * 0.28);

  // Broad waxy highlight
  vec3 h = normalize(light_dir + view_dir);
  float spec = pow(max(dot(normal, h), 0.0), 18.0) * wax * (1.0 - press * 0.7);
  // Warm light bleed
  float edge = 1.0 - max(dot(normal, view_dir), 0.0);
  c = c + vec3(spec) * light_color + clay * pow(edge, 3.0) * 0.25;
  color = c;
}

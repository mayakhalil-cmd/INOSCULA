// Worn car paint: flakes, clear coat, chips, road dust
name "Worn Car Paint";
shading "lit";

uniform vec3 paintCol = vec3(0.45, 0.02, 0.03);  // @color @label Paint
uniform vec3 primer = vec3(0.55, 0.55, 0.52);    // @color @label Primer
uniform float flake = 0.6;                         // @range 0 1 @label Metal Flake
uniform float chips = 0.4;                         // @range 0 1 @label Stone Chips
uniform float swirls = 0.5;                        // @range 0 1 @label Swirl Marks
uniform float roadDust = 0.5;                      // @range 0 1 @label Road Dust
uniform float dustLine = 0.25;                     // @range -1 1 @label Dust Height

void main() {
  vec3 p = object_pos;
  // Metallic flakes
  float cells = voronoi(p, 260.0, 1.0);
  vec3 cellRand = cells.color;
  float sparkle = cellRand.x * flake;
  vec3 base = paintCol * (0.8 + 0.5 * sparkle);

  // Orange peel
  float peel = noise(p, 70.0, 2.0, 0.5, 2.0);

  // Swirl marks
  float sw = 0.5 + 0.5 * sin(length(fract(p * 1.6) - vec3(0.5)) * 220.0 + noise(p, 5.0, 2.0, 0.5, 2.0) * 9.0);
  float swirl = smoothstep(0.92, 1.0, sw) * swirls;

  // Stone chips
  float chipCells = voronoi(p, 18.0, 1.0);
  float chipMask = (1.0 - smoothstep(0.08, 0.12, chipCells)) * step(1.0 - chips * 0.5, chipCells.color.y);
  float bare = (1.0 - smoothstep(0.03, 0.06, chipCells)) * chipMask;
  base = mix(base, primer, chipMask);
  base = mix(base, vec3(0.6), bare);

  // Road dust
  float low = smoothstep(dustLine + 0.3, dustLine - 0.4, p.z);
  float dustAmt = saturate(low * roadDust * (0.6 + 0.8 * noise(p, 4.0, 4.0, 0.6, 2.0)));
  base = mix(base, vec3(0.42, 0.38, 0.33), dustAmt * 0.8);

  color = base;
  roughness = mix(mix(0.08 + swirl * 0.25, 0.55, chipMask), 0.8, dustAmt);
  metallic = mix(mix(0.35 * flake, 0.0, chipMask), 1.0, bare);
  bump = peel * 0.00015 - chipMask * 0.0006;
}

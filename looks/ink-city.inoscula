// Ink city: pen contours and pencil hatching
name "Ink City";

uniform vec3 paper = vec3(0.95, 0.94, 0.90);   // @color @label Paper
uniform vec3 pen = vec3(0.08, 0.08, 0.12);     // @color @label Pen
uniform vec3 wash = vec3(0.55, 0.62, 0.72);    // @color @label Wash
uniform float contours = 9.0;                   // @range 2 30 @label Contour Lines
uniform float hatch = 26.0;                     // @range 5 80 @label Hatch Density
uniform float fps = 6.0;                        // @range 1 24 @label Redraw FPS

void main() {
  float frame = floor(time * fps);
  vec3 jit = vec3(hash(vec3(frame, 1.0, 4.0)), hash(vec3(frame, 2.0, 4.0)), hash(vec3(frame, 3.0, 4.0)));
  vec3 p = object_pos;
  float wobble = noise(p + jit * 3.0, 3.0, 2.0, 0.5, 2.0) - 0.5;

  // Pen contours
  float hgt = p.z * contours + wobble * 0.6;
  float con = smoothstep(0.86, 0.94, abs(fract(hgt) - 0.5) * 2.0);

  // Pencil hatching in the shade
  float tone = saturate(dot(normal, light_dir) * 0.5 + 0.5);
  float h = abs(fract((p.x - p.y + wobble * 0.05) * hatch) - 0.5) * 2.0;
  float hat = (1.0 - smoothstep(tone * 0.9, tone * 0.9 + 0.1, h)) * (1.0 - tone);

  // Outline
  float edge = 1.0 - max(dot(normal, view_dir), 0.0);
  float outl = smoothstep(0.74 + wobble * 0.1, 0.78 + wobble * 0.1, edge);

  vec3 c = mix(paper, wash, (1.0 - tone) * 0.35);
  c = mix(c, pen, max(max(con * 0.85, hat * 0.6), outl));
  color = c;
}

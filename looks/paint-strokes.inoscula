// Paint strokes: layered coats of brush strokes
name "Paint Strokes";

uniform vec3 shadowPaint = vec3(0.07, 0.05, 0.13);       // @color @label Shadow Paint
uniform vec3 midPaint = vec3(0.34, 0.14, 0.3);         // @color @label Mid Paint
uniform vec3 lightPaint = vec3(0.82, 0.28, 0.2);         // @color @label Light Paint
uniform vec3 hotPaint = vec3(1.0, 0.7, 0.4);           // @color @label Highlight Paint
uniform vec3 wetPaint = vec3(0.26, 0.36, 0.78);        // @color @label Reflection Paint
uniform float strokeSize = 1.1;                    // @range 0.5 10 @label Stroke Size
uniform float strokeLength = 2.6;                  // @range 1 8 @label Stroke Length
uniform float brushiness = 0.22;                   // @range 0 1.2 @label Brushiness
uniform float thickness = 1.0;                     // @range 0 1 @label Paint Thickness
uniform float oilAmount = 0.18;                    // @range 0 1 @label Wet Reflection
uniform float erosion = 0.5;                       // @range 0 1 @label Edge Erosion
uniform float fps = 6.0;                           // @range 0 24 @label Repaint FPS
uniform float repaint = 0.0;                       // @range 0 1 @label Repaint Amount
uniform float lineWidth = 0.008;                   // @range 0 0.05 @label Outline Width
uniform vec3 lineColor = vec3(0.06, 0.03, 0.09);  // @color @label Outline Color

vec3 crossv(vec3 a, vec3 b) {
  return vec3(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x);
}

// One layer of brush strokes
vec3 strokeLayer(vec3 p, vec3 dirA, vec3 dirB, float size, float len, float fill, vec3 seed) {
  vec3 dir = mix(dirA, dirB, step(abs(dot(object_normal, dirB)), abs(dot(object_normal, dirA))));
  vec3 q = p + seed;
  vec3 wob = vec3(noise(q, size * 0.7, 2.0, 0.5, 2.0), noise(q + vec3(3.1, 0.0, 0.0), size * 0.7, 2.0, 0.5, 2.0), noise(q + vec3(0.0, 7.3, 0.0), size * 0.7, 2.0, 0.5, 2.0));
  q = q + (wob - vec3(0.5, 0.5, 0.5)) * (0.5 / size);
  q = q * len - dir * dot(q, dir) * (len - 1.0);
  float d = voronoi(q, size, 1.0);
  float r = voronoi(q, size, 1.0).color.x;
  float bristle = noise(q * size * 5.0, 1.0, 2.0, 0.5, 2.0);
  float dry = d + (bristle - 0.5) * 0.3;
  float cover = 1.0 - smoothstep(fill, fill + 0.14, dry);
  float height = (saturate(1.0 - d / fill) * 0.5 + smoothstep(0.3, 0.7, bristle) * 0.5) * smoothstep(fill, fill * 0.6, dry);
  return vec3(cover, r, height);
}

// Four coats of paint
vec3 paint(vec3 p, float size, float len, vec3 seed) {
  vec3 a = strokeLayer(p, vec3(0.95, 0.2, 0.25), vec3(0.2, 0.95, 0.25), size * 0.7, len, 9.0, seed);
  vec3 b = strokeLayer(p, vec3(0.3, 0.2, 0.93), vec3(0.85, -0.5, 0.2), size, len, 0.62, seed + vec3(1.3, 2.9, 0.7));
  vec3 c = strokeLayer(p, vec3(0.7, 0.62, 0.35), vec3(-0.45, 0.35, 0.82), size * 1.5, len, 0.55, seed + vec3(4.2, 0.6, 3.1));
  vec3 e = strokeLayer(p, vec3(0.9, -0.3, 0.3), vec3(0.25, 0.4, 0.88), size * 2.3, len * 1.2, 0.45, seed + vec3(2.2, 5.6, 1.9));
  float v = a.y;
  float h = a.z;
  float sh = 0.0;
  float kb = smoothstep(0.72, 0.8, b.x);
  sh = mix(sh, 0.0, kb) + b.x * (1.0 - kb);
  v = mix(v, b.y, kb);
  h = mix(h, b.z, kb);
  float kc = smoothstep(0.72, 0.8, c.x);
  sh = mix(sh, 0.0, kc) + c.x * (1.0 - kc);
  v = mix(v, c.y, kc);
  h = mix(h, c.z, kc);
  float ke = smoothstep(0.72, 0.8, e.x);
  sh = mix(sh, 0.0, ke) + e.x * (1.0 - ke);
  v = mix(v, e.y, ke);
  h = mix(h, e.z, ke);
  sh = saturate(sh);
  return vec3(v, h * (1.0 - sh), sh);
}

void main() {
  float frame = floor(time * fps);
  vec3 seed = vec3(hash(vec3(frame, 1.0, 3.0)), hash(vec3(frame, 2.0, 3.0)), hash(vec3(frame, 3.0, 3.0))) * repaint * 4.0;
  vec3 pt = paint(object_pos, strokeSize, strokeLength, seed);
  float v = pt.x;
  float h = pt.y;

  // Light on the form
  float l = dot(normal, light_dir) * 0.5 + 0.5;
  float t = l + (v - 0.5) * brushiness;
  vec3 c = shadowPaint;
  c = mix(c, midPaint, smoothstep(0.44, 0.46, t));
  c = mix(c, lightPaint, smoothstep(0.64, 0.66, t));
  c = mix(c, hotPaint, smoothstep(0.91, 0.93, t));

  // Depth
  float body = h;
  c = c * (1.0 - thickness * 0.3 + thickness * 0.5 * body) * (0.92 + 0.16 * v);
  c = c * (1.0 - pt.z * thickness * 0.45);
  c = c + hotPaint * smoothstep(0.82, 0.95, body) * smoothstep(0.45, 0.8, l) * thickness * 0.35;

  // Wet oil
  vec3 rv = reflect(vec3(0.0) - view_dir, normal);
  float wet = smoothstep(0.6, 0.95, dot(rv, light_dir) + (v - 0.5) * 0.5);
  c = mix(c, wetPaint, wet * oilAmount);

  // Silhouette breakup
  float edge = 1.0 - max(dot(normal, view_dir), 0.0);
  float keep = step(edge * edge * edge * erosion * 1.6, v * 0.6 + body * 0.4);
  color = c;
  alpha = erosion > 0.0 ? keep : 1.0;
  outline = lineWidth;
  outline_color = lineColor;
  outline_breakup = 0.45;
}

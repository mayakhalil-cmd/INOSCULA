// Painted planes: tilted stroke normals, small palette
name "Painted Planes";

uniform vec3 baseColor = vec3(0.55, 0.32, 0.42);    // @color @label Base
uniform vec3 shadowAccent = vec3(0.18, 0.16, 0.36); // @color @label Shadow Accent
uniform vec3 lightAccent = vec3(0.95, 0.62, 0.45);  // @color @label Light Accent
uniform vec3 specAccent = vec3(1.0, 0.92, 0.62);    // @color @label Highlight Accent
uniform float strokeSize = 3.0;                      // @range 1 16 @label Stroke Size
uniform float strokeLength = 3.0;                    // @range 1 8 @label Stroke Length
uniform float painterlyNormals = 0.3;                // @range 0 2 @label Painterly Normals Strength
uniform float shine = 24.0;                          // @range 2 80 @label Highlight Tightness
uniform float lineWidth = 0.006;                     // @range 0 0.05 @label Outline Width
uniform vec3 lineColor = vec3(0.08, 0.05, 0.1);     // @color @label Outline Colour

// One stroke's random tilt
vec3 tilt(vec3 p, vec3 dir, float size, float len) {
  vec3 q = p * len - dir * dot(p, dir) * (len - 1.0);
  q = q + vec3(noise(p, size, 2.0, 0.5, 2.0), noise(p + vec3(4.0, 0.0, 0.0), size, 2.0, 0.5, 2.0), 0.0) * (0.6 / size);
  return voronoi(q, size, 1.0).color - vec3(0.5, 0.5, 0.5);
}

void main() {
  vec3 p = object_pos;
  vec3 dirA = normalize(vec3(1.0, 0.3, 0.2));
  vec3 dirB = normalize(vec3(0.2, 0.3, 1.0));
  vec3 dir = mix(dirA, dirB, step(abs(dot(object_normal, dirB)), abs(dot(object_normal, dirA))));
  vec3 n = normalize(normal + tilt(p, dir, strokeSize, strokeLength) * painterlyNormals * 2.0);

  float d = dot(n, light_dir);
  vec3 c = mix(shadowAccent, baseColor, step(0.0, d));
  c = mix(c, lightAccent, step(0.5, d));
  vec3 r = reflect(vec3(0.0) - light_dir, n);
  float s = pow(max(dot(r, view_dir), 0.0), shine);
  c = mix(c, specAccent, step(0.5, s));
  color = c;
  outline = lineWidth;
  outline_color = lineColor;
  outline_breakup = 0.3;
}

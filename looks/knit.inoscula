// Knit: stockinette stitches and stripes
name "Knit";

uniform vec3 yarn = vec3(0.82, 0.30, 0.25);   // @color @label Yarn
uniform vec3 stripe = vec3(0.95, 0.88, 0.70); // @color @label Stripe Yarn
uniform float cols = 48.0;                     // @range 8 160 @label Stitches Across
uniform float rows = 36.0;                     // @range 8 160 @label Rows
uniform float stripeEvery = 6.0;               // @range 0 20 @label Stripe Every (rows)
uniform float fuzz = 0.5;                      // @range 0 1 @label Fuzz

void main() {
  float u = uv.x * cols;
  float v = uv.y * rows;
  float x = abs(fract(u) - 0.5) * 2.0;
  float y = fract(v);

  // Each stitch is two slanted legs
  float centre = 0.12 + 0.62 * y;
  float leg = 1.0 - smoothstep(0.0, 0.32, abs(x - centre));
  // Yarn twist
  float ply = 0.5 + 0.5 * sin((y * 3.0 - x * 2.0) * 9.0);
  float yarnHeight = leg * (0.8 + 0.2 * ply);

  // Stripes every few rows
  float rowIndex = floor(v);
  float isStripe = stripeEvery > 0.5 ? step(stripeEvery - 0.5, mod(rowIndex, stripeEvery * 2.0)) : 0.0;
  vec3 base = mix(yarn, stripe, isStripe);

  // Light
  float ndl = dot(normal, light_dir);
  float light = smoothstep(-0.5, 1.0, ndl);
  float hair = noise(object_pos, 90.0, 2.0, 0.5, 2.0);
  vec3 c = base * (0.25 + 0.85 * yarnHeight) * (0.45 + 0.65 * light);
  c = c * (0.9 + 0.2 * hair);

  float edge = 1.0 - max(dot(normal, view_dir), 0.0);
  c = c + base * pow(edge, 2.5) * fuzz * 0.6 * smoothstep(0.4, 0.8, hair);
  color = c;
}

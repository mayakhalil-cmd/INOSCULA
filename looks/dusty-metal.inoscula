// Dusty metal: brushed steel, chipped paint, grime, dust
name "Dusty Metal";
shading "lit";

uniform vec3 steel = vec3(0.56, 0.57, 0.58);     // @color @label Steel
uniform vec3 paint = vec3(0.09, 0.16, 0.22);     // @color @label Paint
uniform vec3 dustCol = vec3(0.47, 0.43, 0.37);   // @color @label Dust
uniform float paintCover = 0.65;                  // @range 0 1 @label Paint Cover
uniform float wear = 0.55;                        // @range 0 1 @label Edge Wear
uniform float dust = 0.6;                         // @range 0 1 @label Dust
uniform float scratches = 0.5;                    // @range 0 1 @label Scratches
uniform float grime = 0.6;                        // @range 0 1 @label Grime

// Thin scratches
float scratchField(vec3 p, float density) {
  float a = voronoi(p * vec3(1.0, 1.0, 22.0), density, 1.0);
  float b = voronoi(p * vec3(22.0, 1.0, 1.0) + vec3(7.1), density * 0.8, 1.0);
  float lineA = 1.0 - smoothstep(0.0, 0.035, a);
  float lineB = 1.0 - smoothstep(0.0, 0.03, b);
  return max(lineA, lineB * 0.7);
}

void main() {
  vec3 p = object_pos;
  float up = smoothstep(0.1, 0.9, normal.z);
  float breakup = noise(p, 3.0, 5.0, 0.6, 2.0);
  float fine = noise(p, 40.0, 3.0, 0.5, 2.0);

  // Brushed steel
  float brushed = noise(p * vec3(1.0, 1.0, 60.0), 8.0, 2.0, 0.5, 2.0);
  vec3 metalCol = steel * (0.85 + 0.25 * brushed);
  float metalRough = 0.22 + 0.18 * brushed;

  // Chipped paint
  float edge = smoothstep(0.55, 0.75, curvature + (breakup - 0.5) * 0.3);
  float chip = smoothstep(0.45, 0.55, breakup + edge * wear - (1.0 - paintCover));
  float painted = 1.0 - chip;
  vec3 base = mix(metalCol, paint * (0.9 + 0.2 * fine), painted);
  float rough = mix(metalRough, 0.55 + 0.1 * fine, painted);
  float metal = mix(1.0, 0.0, painted);

  // Grime gathers in crevices
  float crevice = (1.0 - occlusion) * grime * (0.6 + 0.8 * breakup);
  base = base * (1.0 - saturate(crevice) * 0.7);
  rough = mix(rough, 0.9, saturate(crevice));

  // Scratches
  float sc = scratchField(p, 6.0) * scratches * smoothstep(0.3, 0.6, noise(p, 1.5, 2.0, 0.5, 2.0));
  base = mix(base, steel * 1.15, sc);
  rough = mix(rough, 0.18, sc);
  metal = mix(metal, 1.0, sc);

  // Dust settles on top
  float d = saturate(up * dust * (0.55 + 0.9 * breakup) - edge * 0.4 + (occlusion - 1.0) * -0.2);
  d = smoothstep(0.15, 0.85, d);
  base = mix(base, dustCol * (0.9 + 0.2 * fine), d);
  rough = mix(rough, 0.95, d);
  metal = mix(metal, 0.0, d);

  color = base;
  roughness = rough;
  metallic = metal;
  bump = -sc * 0.0008 + d * 0.0004 * fine + brushed * 0.0001;
}

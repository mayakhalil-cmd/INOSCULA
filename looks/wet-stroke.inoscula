// Wet stroke: wet paint, oily sheen, rim and outlines
name "Wet Stroke";
shading "lit";
surface "cutout";
shells 0.025, 0.05, 0.025;

uniform vec3 shadowTone = vec3(0.04, 0.025, 0.08);  // @color @label Shadow Tone
uniform vec3 undertone = vec3(0.0, 0.22, 0.2);      // @color @label Shadow Undertone
uniform vec3 midTone = vec3(0.22, 0.03, 0.42);       // @color @label Mid Tone
uniform vec3 lightTone = vec3(1.0, 0.12, 0.38);      // @color @label Light Tone
uniform vec3 overtone = vec3(1.0, 0.5, 0.12);       // @color @label Light Overtone
uniform float toneCount = 3.0;                       // @range 2 3 @label Tones (2 or 3)
uniform float toneSplit = 0.5;                       // @range 0 1 @label Undertone and Overtone Mix
uniform float toonLow = 0.12;                        // @range -1 1 @label Shadow Edge
uniform float toonHigh = 0.55;                       // @range -1 1 @label Light Edge
uniform vec3 reflectA = vec3(0.95, 0.2, 0.55);      // @color @label Reflection Colour A
uniform vec3 reflectB = vec3(1.0, 0.62, 0.2);       // @color @label Reflection Colour B
uniform float reflectStart = 0.25;                   // @range -1 1 @label Reflection Start
uniform float reflectAmount = 0.9;                   // @range 0 1 @label Reflection Amount
uniform vec3 sheenA = vec3(0.35, 0.15, 0.85);       // @color @label Sheen Violet
uniform vec3 sheenB = vec3(1.0, 0.3, 0.6);          // @color @label Sheen Pink
uniform vec3 sheenC = vec3(1.0, 0.55, 0.15);        // @color @label Sheen Orange
uniform float sheen = 0.7;                           // @range 0 1 @label Sheen
uniform float lightTint = 0.6;                       // @range 0 1 @label Takes The Light Colour
uniform float strokeSize = 2.4;                      // @range 0.5 10 @label Stroke Density
uniform float strokeLength = 3.2;                    // @range 1 8 @label Stroke Length
uniform float combing = 1.6;                         // @range 0 4 @label Dragged Edges
uniform float followView = 1.0;                      // @range 0 1 @label Strokes Follow The View
uniform float adapt = 1.0;                           // @range 0 1 @label Adapt To Object
uniform float normalRandom = 0.6;                    // @range 0 2 @label Stroke Normal Randomness
uniform float heightRatio = 0.06;                    // @range 0 0.3 @label Stroke Depth (bump offset)
uniform float strokeRelief = 2.0;                    // @range 0 6 @label Stroke Relief (bump)
uniform float aoStrength = 0.8;                      // @range 0 1 @label Occlusion
uniform float erosion = 0.55;                        // @range 0 1 @label Rim Erosion
uniform float erosionScale = 6.0;                    // @range 1 30 @label Erosion Texture Scale
uniform float rimErosion = 0.6;                      // @range 0 1 @label Outer Rim Erosion
uniform vec3 outlineColor = vec3(0.23, 1.0, 0.02);  // @color @label Outline Colour
uniform float outlineThin = 0.14;                    // @range 0.01 0.4 @label Outline Thickness
uniform float outlineBreak = 0.45;                   // @range 0 1 @label Outline Breakup
uniform float outlineFragments = 0.35;               // @range 0 1 @label Outline Fragments
uniform float metal = 0.5;                           // @range 0 1 @label Reflectivity
uniform float rough = 0.3;                           // @range 0 1 @label Roughness
uniform float litMix = 0.25; 
uniform float glow = 0.9;                            // @range 0 1.5 @label Paint Brightness                        // @range 0 1 @label Real Light On Top
uniform float fps = 0.0;                             // @range 0 24 @label Repaint FPS
uniform float drift = 0.0;                           // @range 0 1 @label Drift

vec3 crossv(vec3 a, vec3 b) {
  return vec3(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x);
}

// One coat of dabs
vec3 dabCoat(vec3 p, vec3 n, vec3 axis, float size, float len, vec3 seed) {
  // Two overlapping sets of patches
  vec3 pp = p + seed;
  float pa = voronoi(pp, size * 0.3, 1.0);
  float pb = voronoi(pp + vec3(17.3, 9.1, 4.7), size * 0.3, 1.0);
  float useB = step(pb + (noise(pp * size * 0.9, 1.0, 2.0, 0.5, 2.0) - 0.5) * 0.25, pa);
  vec3 pc = mix(pa.position, pb.position - vec3(17.3, 9.1, 4.7), useB);
  vec3 pr = mix(pa.color, pb.color, useB);
  // Strokes follow the form
  vec3 tA = crossv(n, axis);
  vec3 tB = crossv(n, normalize(p + vec3(0.0001, 0.0002, 0.0003)));
  vec3 t = normalize(tA + tB * saturate(1.0 - length(tA) * 2.0) * 2.0 + crossv(n, vec3(0.31, 0.47, 0.83)) * 0.3 + vec3(0.0001, 0.0002, 0.0003));
  // Each patch turns a little
  t = normalize(t + crossv(n, t) * (pr.x - 0.5) * mix(0.45, 4.0, saturate(1.0 - length(tA) * 2.5)));
  vec3 o = pp - pc;
  float along = dot(o, t);
  // Rounder dabs facing the camera
  float lenHere = mix(len, 1.0, pow(saturate(dot(n, axis)), 6.0));
  vec3 o2 = (o - t * along) * lenHere + t * along;
  // Dragged dab ends
  float comb = noise((o - t * along) * size * lenHere * 2.5 + pr * 5.0, 1.0, 2.0, 0.5, 2.0);
  o2 = o2 + t * (comb - 0.5) * (combing / size);
  float d = voronoi(o2 + pr * 37.0, size, 1.0);
  vec3 r = d.color;
  float streak = noise((o - t * along) * size * lenHere * 5.0 + t * along * size * 0.7 + pr * 11.0, 1.0, 2.0, 0.5, 2.0);
  // Paint height
  float h = (1.0 - d) * 0.3 + streak * 0.1;
  return vec3(r.x, h, streak);
}

// Brush position
vec3 adaptPos(vec3 op, vec3 on) {
  // Size scaling
  return op * pow(2.6 / max(object_size, 0.001), adapt * 0.7);
}

// Two coats
vec3 paint2(vec3 p, vec3 n, vec3 axis, float size, float len, vec3 seed) {
  vec3 a = dabCoat(p, n, axis, size, len, seed);
  vec3 b = dabCoat(p, n, axis, size * 1.4, len, seed + vec3(5.1, 2.3, 7.7));
  float top = step(0.5, hash(vec3(floor(b.x * 997.0), 1.0, 1.0)));
  return vec3(mix(a.x, b.x, top), mix(a.y, 1.0 + b.y, top), mix(a.z, b.z, top));
}

void main() {
  float frame = floor(time * fps);
  vec3 seed = vec3(hash(vec3(frame, 1.0, 2.0)), hash(vec3(frame, 2.0, 2.0)), hash(vec3(frame, 3.0, 2.0))) * step(0.001, fps) * 3.0 + vec3(time * drift * 0.1, 0.0, time * drift * 0.05);
  float kind = floor(uv.x) - 200.0;
  float shell = step(-0.5, kind);
  float isLine = step(0.5, kind);
  vec3 nWorld = mix(normal, vec3(0.0) - normal, shell);
  vec3 V = view_dir;
  vec3 axis = normalize(mix(vec3(0.0, 0.0, 1.0), V, followView));

  // Strokes
  vec3 p0 = adaptPos(object_pos, object_normal);
  // Height for the offset
  float h0 = noise(p0 * strokeSize * 1.5 + seed, 1.0, 2.0, 0.5, 2.0);
  vec3 pt = paint2(adaptPos(object_pos - V * (h0 - 0.5) * heightRatio, object_normal), nWorld, axis, strokeSize, strokeLength, seed);
  float rnd = pt.x;
  float streak = pt.z;
  float grey = fract(rnd * 7.13);

  // Each stroke's own normal
  vec3 T = normalize(crossv(nWorld, vec3(0.0, 0.0, 1.0)) + vec3(0.0001, 0.0002, 0.0));
  vec3 B = crossv(nWorld, T);
  vec3 tl = vec3(fract(rnd * 3.7) - 0.5, fract(rnd * 11.3) - 0.5, 0.0) * 2.0 * normalRandom;
  vec3 nS = normalize(nWorld * 0.95 + T * tl.x + B * tl.y);

  // Painted light in steps
  vec3 lc = mix(vec3(1.0, 1.0, 1.0), light_color / max(max(light_color.x, light_color.y), max(light_color.z, 0.001)), lightTint);
  float d = dot(nS, light_dir) * mix(1.0, occlusion, aoStrength * 0.6);
  vec3 shadowCol = mix(shadowTone, undertone, grey * toneSplit);
  vec3 lightCol = mix(lightTone, overtone, (1.0 - grey) * toneSplit) * lc;
  vec3 midCol = mix(lightCol, mix(midTone, mix(shadowTone, lightTone, 0.5), grey * 0.3) * mix(vec3(1.0, 1.0, 1.0), lc, 0.5), step(2.5, toneCount));
  vec3 c = mix(shadowCol, midCol, step(toonLow, d));
  c = mix(c, lightCol, step(toonHigh, d));
  c = c * (0.88 + 0.24 * streak);

  // Reflections
  vec3 tr = vec3(fract(rnd * 5.9) - 0.5, fract(rnd * 17.1) - 0.5, 0.0) * 2.0 * normalRandom;
  vec3 nR = normalize(nWorld * 0.95 + T * tr.y + B * tr.x);
  vec3 rv = reflect(vec3(0.0) - V, nR);
  float rl = saturate(dot(rv, light_dir) - reflectStart);
  c = mix(c, mix(reflectA, reflectB, sqrt(rl)) * lc, step(0.001, rl) * reflectAmount * saturate(rl * 5.0));

  // Angle sheen
  float facing = saturate(dot(nWorld, V));
  float x = pow(1.0 - facing, 0.7) + (streak - 0.5) * 0.3 + (rnd - 0.5) * 0.25;
  vec3 ramp = mix(sheenA, sheenB, smoothstep(0.35, 0.6, x));
  ramp = mix(ramp, sheenC, smoothstep(0.62, 0.85, x)) * lc;
  c = mix(c, ramp, smoothstep(0.4, 0.75, x) * sheen * step(0.3, fract(rnd * 2.3)));

  // Occlusion ending in brush strokes
  c = c * mix(1.0, step(streak * 0.8 + 0.1, occlusion) * 0.6 + 0.4, aoStrength);

  // Rim erosion
  float viewTex = noise(vec3(V.x * erosionScale, V.y * erosionScale * 0.3, V.z * erosionScale) + nWorld * 2.0, 1.0, 3.0, 0.6, 2.0);
  float keepBody = step(erosion * 0.35, facing + (viewTex - 0.5) * erosion * 0.4 + streak * 0.05);

  // Shells
  float facingIn = dot(normal, V);
  float keepRim = step(0.0, facingIn) * step(rimErosion * 0.35 * (1.0 - streak), facingIn + viewTex * 0.12);
  float br = noise(object_pos * 5.0 + vec3(kind * 7.0, 0.0, 0.0), 1.0, 2.0, 0.5, 2.0);
  float frag = noise(object_pos * 1.6 + vec3(kind * 3.0, 1.0, 0.0), 1.0, 1.0, 0.5, 2.0);
  float keepLine = step(0.0, facingIn) * (1.0 - step(outlineThin * (0.5 + br), facingIn)) * step(outlineBreak * 0.7, br) * step(outlineFragments * 0.7, frag);
  c = mix(c, outlineColor, isLine);

  color = c * litMix;
  emission = c * glow;
  metallic = metal * (1.0 - shell);
  roughness = mix(rough + streak * 0.2, 1.0, shell);
  bump = (pt.y + streak * 0.2) * strokeRelief * (0.04 / strokeSize) * pow(object_size / 2.6, adapt * 0.7) * (1.0 - shell);
  alpha = mix(keepBody, mix(keepRim, keepLine, isLine), shell);
}

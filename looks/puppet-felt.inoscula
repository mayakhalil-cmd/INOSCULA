// Puppet felt: matted felt with fuzz
name "Puppet Felt";

uniform vec3 felt = vec3(0.20, 0.36, 0.30);   // @color @label Felt
uniform vec3 fuzzCol = vec3(0.72, 0.86, 0.78); // @color @label Fuzz
uniform float fiber = 40.0;                    // @range 10 120 @label Fiber Scale
uniform float fuzz = 0.8;                      // @range 0 2 @label Fuzz
uniform float fps = 12.0;                      // @range 1 24 @label Frames Per Second

void main() {
  float frame = floor(time * fps);
  vec3 shift = vec3(hash(vec3(frame, 7.0, 0.0)), hash(vec3(frame, 8.0, 0.0)), 0.0) * 0.3;
  vec3 p = object_pos;

  // Matted fibers
  float f1 = noise(p * vec3(1.0, 6.0, 1.0) + shift, fiber, 2.0, 0.6, 2.0);
  float f2 = noise(p * vec3(6.0, 1.0, 1.0) - shift, fiber, 2.0, 0.6, 2.0);
  float mat = f1 * 0.5 + f2 * 0.5;
  float clump = noise(p, 4.0, 3.0, 0.5, 2.0);

  float ndl = dot(normal, light_dir);
  float light = smoothstep(-0.5, 1.0, ndl);
  vec3 c = felt * (0.55 + 0.7 * light) * (0.75 + 0.5 * mat) * (0.85 + 0.3 * clump);

  // Fuzz
  float edge = 1.0 - max(dot(normal, view_dir), 0.0);
  float halo = pow(edge, 2.2) * smoothstep(0.35, 0.75, mat) * fuzz;
  c = c + fuzzCol * halo * (0.4 + 0.6 * light);
  color = c;
}

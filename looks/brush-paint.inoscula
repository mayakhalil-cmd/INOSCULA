// Brush paint: faceted planes, brush strokes, ink outline
name "Brush Paint";
shading "lit";

uniform vec3 shadowPaint = vec3(0.10, 0.07, 0.20);  // @color @label Shadow Paint
uniform vec3 midPaint = vec3(0.55, 0.18, 0.22);     // @color @label Mid Paint
uniform vec3 lightPaint = vec3(0.95, 0.52, 0.30);   // @color @label Light Paint
uniform vec3 hotPaint = vec3(1.0, 0.88, 0.62);      // @color @label Highlight Paint
uniform float facets = 3.5;                          // @range 0.5 12 @label Facet Size
uniform float soften = 0.45;                         // @range 0 1 @label Soften Facets
uniform float strokeScale = 9.0;                     // @range 2 40 @label Stroke Size
uniform float strokeAmount = 0.55;                   // @range 0 1 @label Stroke Strength
uniform float impasto = 1.6;                         // @range 0 4 @label Impasto
uniform float fps = 8.0;                             // @range 0 24 @label Repaint FPS
uniform float boil = 1.0;                            // @range 0 1 @label Repaint Amount
uniform float lineWidth = 0.012;                     // @range 0 0.05 @label Outline Width
uniform vec3 lineColor = vec3(0.03, 0.02, 0.04);    // @color @label Outline Colour
uniform float lineBreakup = 0.35;                    // @range 0 0.9 @label Outline Breakup

// One stroke field
float strokes(vec3 p, float size, vec3 shift) {
  float patch = voronoi(p + shift, size * 0.35, 1.0);
  vec3 rnd = patch.color;
  vec3 axis = normalize(rnd - vec3(0.5));
  float along = dot(p, axis);
  vec3 across = p - axis * along;
  // Stretched along the stroke
  float bristle = noise(across * size * 3.0 + axis * along * size * 0.25 + shift, 1.0, 3.0, 0.6, 2.0);
  float body = smoothstep(0.25, 0.75, bristle);
  // Dab ends fade
  float dab = smoothstep(0.0, 0.25, patch) * (0.7 + 0.3 * rnd.y);
  return mix(0.5, body, dab);
}

void main() {
  float frame = floor(time * fps);
  vec3 shift = vec3(hash(vec3(frame, 1.0, 7.0)), hash(vec3(frame, 2.0, 7.0)), hash(vec3(frame, 3.0, 7.0))) * boil * 3.0;

  // Stroke field
  vec3 wobble = vec3(noise(object_pos, 2.5, 3.0, 0.5, 2.0), noise(object_pos + vec3(4.1), 2.5, 3.0, 0.5, 2.0), noise(object_pos + vec3(8.3), 2.5, 3.0, 0.5, 2.0));
  vec3 n = mix(object_normal, wobble * 2.0 - vec3(1.0), soften);
  float planes = voronoi(n, facets, 1.0).color.x;

  // Reflections
  float s = strokes(object_pos, strokeScale, shift);

  // Occlusion
  float v = planes * mix(1.0, s * 1.6, strokeAmount);
  vec3 c = mix(shadowPaint, midPaint, smoothstep(0.08, 0.3, v));
  c = mix(c, lightPaint, smoothstep(0.35, 0.6, v));
  c = mix(c, hotPaint, smoothstep(0.72, 0.95, v));
  color = c;

  // Rim erosion
  roughness = mix(0.82, 0.38, smoothstep(0.55, 0.85, s));
  metallic = 0.0;

  // Shells
  bump = (s - 0.5) * impasto * 0.0025;
  outline = lineWidth;
  outline_color = lineColor;
  outline_breakup = lineBreakup;
}
